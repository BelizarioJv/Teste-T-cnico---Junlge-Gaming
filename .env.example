# Banco de dados Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wagering_db

# Banco de dados MikroORM
DB_HOST=localhost
DB_PORT=5433
DB_NAME=wagering_db
DB_USER=postgres
DB_PASSWORD=change-me

# SQS (ElasticMQ local do docker-compose; para LocalStack use http://localhost:4566)
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:9324
SQS_ACCESS_KEY_ID=test
SQS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_URL=http://localhost:9324/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:9324/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:9324/000000000000/wallet-events.fifo
SQS_MAX_RECEIVE_COUNT=3

# Workers (desligados por padrão; ligue na instância que deve consumir/publicar)
SQS_CONSUMER_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true

# Reconciliação wallet × ledger periódica (0 = desligada)
RECONCILIATION_INTERVAL_MS=300000

# Logs: json (produção) | pretty (desenvolvimento)
LOG_FORMAT=json
LOG_LEVEL=info
